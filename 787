  function pushSpdIntv() {
    if (!sim.btnVNAV) {
      setCoach(
        'Speed Intervention (VNAV 모드에서만 작동)',
        '현재는 VNAV 모드가 아니므로 이미 MCP 속도창이 열려 있습니다.',
        '<span class="tag-b787">Boeing 787</span> VNAV가 켜진 상태에서 IAS 노브를 누르면 <b>Speed Intervention</b>이 작동합니다.'
      );
      return;
    }
    sim.spdWindowOpen = !sim.spdWindowOpen;
    if (sim.spdWindowOpen) {
      sim.mcpSpd = Math.round(sim.ias / 5) * 5;
      if (sim.fmaPitch === 'VNAV PTH') {
        sim.fmaPitch = 'VNAV SPD';
        highlightFMA(3);
      }
      setCoach(
        'Speed Intervention 활성화 (VNAV 중 수동 속도 개입)',
        '<b>VNAV를 끄지 않고도</b> MCP IAS/MACH 속도창이 열렸습니다! 이제 조종사가 원하는 속도를 직접 다이얼할 수 있으며, FMS의 고도 제한(Constraint)은 그대로 보호됩니다.',
        '<span class="tag-bus">Airbus</span> Managed CLB/DES 중 SPD 노브만 <b>Pull (Selected Speed)</b>한 것과 완벽히 같습니다.<br><span class="tag-b787">Boeing 787</span> IAS 노브를 한 번 더 누르면 다시 FMS 속도로 복귀합니다.'
      );
    } else {
      evaluateVnavMode();
      setCoach(
        'Speed Intervention 해제 (FMS 속도로 복귀)',
        'MCP 속도창이 다시 닫히고(Blank) FMS 목표 속도를 추종합니다.',
        '<span class="tag-bus">Airbus</span> SPD 노브를 다시 <b>Push (Managed Speed)</b>한 것과 동일합니다.'
      );
    }
    updateMCPDOM();
  }

  function pushAltIntv() {
    const activeLeg = sim.legs[0];
    if (sim.btnVNAV && activeLeg && activeLeg.type !== 'NONE' && sim.mcpAlt > activeLeg.alt) {
      const deletedAlt = activeLeg.alt;
      activeLeg.type = 'NONE';
      evaluateVnavMode();
      highlightFMA(3);
      renderCDU();
      setCoach(
        `Altitude Intervention: ${activeLeg.id} 고도 구속(${deletedAlt}ft) 삭제!`,
        `MCP 고도를 ${sim.mcpAlt}ft로 올려두고 <b>ALT 노브를 PUSH</b>하여 다음 웨이포인트(${activeLeg.id})의 고도 제한을 즉시 해제했습니다.`,
        '<span class="tag-bus">Airbus</span> ATC가 "Climb unrestricted" 지시 시 고도 노브를 <b>Pull (OP CLB)</b>하면 모든 구속을 무시하지만, <span class="tag-b787">Boeing 787</span>은 <b>ALT PUSH</b>를 누를 때마다 다음 구속고도를 <b>하나씩</b> 깔끔하게 지워줍니다.'
      );
      return;
    }

    if (sim.fmaPitch === 'VNAV ALT') {
      evaluateVnavMode();
      highlightFMA(3);
      setCoach(
        'VNAV ALT 해제 → 상승/강하 재개!',
        `MCP 고도를 변경한 후 <b>ALT 노브를 PUSH</b>하여 <b>VNAV ALT</b> 고도 포착 상태에서 벗어나 다시 상승/강하를 시작합니다.`,
        '<span class="tag-bus">Airbus</span> 고도가 ALT* / ALT로 잡힌 뒤 고도를 바꾸고 <b>Push (Managed CLB)</b>를 누르는 절차와 동일합니다.<br><span class="tag-b787">Boeing 787</span> <b>VNAV ALT</b>에 걸렸을 때는 MCP 고도 변경 후 반드시 <b>ALT 노브를 PUSH</b>해야 합니다!'
      );
    } else {
      evaluateVnavMode();
      setCoach(
        'Altitude Intervention (ALT PUSH)',
        'VNAV 비행 중 고도 구속조건을 삭제하거나 VNAV ALT에서 상승/강하를 재개할 때 사용합니다.',
        '<span class="tag-b787">Boeing 787 핵심 팁</span> 에어버스의 Push-to-Level-Off 기능이 아닙니다!'
      );
    }
    updateMCPDOM();
  }

  function pressFLCH() {
    sim.btnFLCH = true;
    sim.btnVNAV = false;
    sim.btnVS = false;
    sim.btnHOLD = false;
    sim.spdWindowOpen = true;
    sim.fmaPitch = 'FLCH SPD';
    sim.fmaAT = sim.mcpAlt >= sim.alt ? 'THR REF' : 'HOLD';
    highlightFMA(3);
    setCoach(
      'FLCH SPD 결합 (Flight Level Change — 고도 구속 무시!)',
      `FMS의 모든 웨이포인트 고도 구속조건(예: BOPTA 10000A)을 <b>무시</b>하고 오직 MCP 고도(<b>${sim.mcpAlt}ft</b>)까지 추력/피치로 즉시 상승/강하합니다.`,
      '<span class="tag-bus">Airbus</span> ALT 노브를 몸쪽으로 당기는 <b>OP CLB / OP DES (Open Climb/Descent)</b>와 100% 동일한 개념입니다!'
    );
    updateMCPDOM();
  }

  function pressVS() {
    sim.btnVS = true;
    sim.btnVNAV = false;
    sim.btnFLCH = false;
    sim.btnHOLD = false;
    sim.spdWindowOpen = true;
    sim.fmaPitch = 'V/S';
    sim.fmaAT = 'SPD';
    highlightFMA(3);
    setCoach(
      'V/S 모드 결합 (Vertical Speed)',
      `분당 수직속도(<b>${sim.mcpVS >= 0 ? '+' : ''}${sim.mcpVS} fpm</b>)를 피치로 유지하고, 속도는 A/T(SPD)가 유지합니다.`,
      '<span class="tag-bus">Airbus</span> V/S 노브를 <b>Pull</b>한 것과 동일합니다.'
    );
    updateMCPDOM();
  }

  function pressAltHold() {
    sim.btnHOLD = true;
    sim.btnVNAV = false;
    sim.btnFLCH = false;
    sim.btnVS = false;
    sim.spdWindowOpen = true;
    sim.mcpAlt = Math.round(sim.alt / 100) * 100;
    sim.fmaPitch = 'ALT';
    sim.fmaAT = 'SPD';
    highlightFMA(3);
    setCoach(
      'ALT HOLD 결합 (현재 고도 즉시 유지)',
      '현재 고도에서 즉시 수평 비행으로 전환합니다.',
      '<span class="tag-bus">Airbus</span> V/S 노브를 <b>Push to Level Off</b> 하는 동작에 해당합니다.'
    );
    updateMCPDOM();
  }

  function pressAPP() {
    sim.btnAPP = !sim.btnAPP;
    if (sim.btnAPP) {
      sim.fmaRollArmed = 'LOC';
      sim.fmaPitchArmed = 'G/S';
      setCoach(
        'APP 무장 (LOC 및 G/S Armed)',
        'PFD FMA 하단에 흰색 작은 글씨로 <b>LOC</b>와 <b>G/S</b>가 무장(Armed)되었습니다.',
        '<span class="tag-bus">Airbus</span> FCU의 <b>APPR</b> 버튼과 동일합니다.'
      );
    } else {
      sim.fmaRollArmed = '';
      sim.fmaPitchArmed = '';
    }
    updateMCPDOM();
  }

  function changeSpd(delta) {
    if (!sim.spdWindowOpen) return;
    sim.mcpSpd = Math.max(140, Math.min(340, sim.mcpSpd + delta));
    updateMCPDOM();
  }

  function changeHdg(delta) {
    sim.mcpHdg = (sim.mcpHdg + delta + 360) % 360;
    updateMCPDOM();
  }

  function changeVS(delta) {
    if (!sim.btnVS) pressVS();
    sim.mcpVS = Math.max(-4000, Math.min(4000, sim.mcpVS + delta));
    updateMCPDOM();
  }

  function changeAlt(delta) {
    sim.mcpAlt = Math.max(1000, Math.min(41000, sim.mcpAlt + delta));
    updateMCPDOM();
  }

  function evaluateVnavMode() {
    if (!sim.btnVNAV) return;
    const targetAlt = getEffectiveVnavTargetAlt();
    const diff = targetAlt - sim.alt;

    if (Math.abs(diff) < 120) {
      if (Math.abs(sim.mcpAlt - sim.alt) < 150 && sim.mcpAlt < sim.fmsCrzAlt) {
        sim.fmaPitch = 'VNAV ALT';
        sim.fmaAT = 'SPD';
      } else {
        sim.fmaPitch = 'VNAV PTH';
        sim.fmaAT = 'SPD';
      }
    } else if (diff > 0) {
      sim.fmaPitch = 'VNAV SPD';
      sim.fmaAT = 'THR REF';
    } else {
      sim.fmaPitch = sim.spdWindowOpen ? 'VNAV SPD' : 'VNAV PTH';
      sim.fmaAT = 'HOLD';
    }
  }

  function getEffectiveVnavTargetAlt() {
    const activeLeg = sim.legs[0];
    if (activeLeg && activeLeg.type !== 'NONE') {
      if (sim.alt <= activeLeg.alt + 150) {
        return Math.min(sim.mcpAlt, activeLeg.alt);
      }
    }
    return sim.mcpAlt;
  }

  function updateMCPDOM() {
    const winSpd = document.getElementById('winSpd');
    if (sim.spdWindowOpen) {
      winSpd.textContent = sim.mcpSpd;
      winSpd.classList.remove('blank');
    } else {
      winSpd.textContent = '---';
      winSpd.classList.add('blank');
    }

    document.getElementById('winHdg').textContent = String(sim.mcpHdg).padStart(3, '0');
    document.getElementById('winAlt').textContent = sim.mcpAlt;

    const winVS = document.getElementById('winVS');
    if (sim.btnVS) {
      winVS.textContent = (sim.mcpVS >= 0 ? '+' : '') + sim.mcpVS;
      winVS.classList.remove('blank');
    } else {
      winVS.textContent = '----';
      winVS.classList.add('blank');
    }

    const setBtn = (id, state) => {
      document.getElementById(id).classList.toggle('active', state);
    };
    setBtn('btnAT', sim.atArmed);
    setBtn('btnLNAV', sim.btnLNAV);
    setBtn('btnVNAV', sim.btnVNAV);
    setBtn('btnFLCH', sim.btnFLCH);
    setBtn('btnHDG', sim.btnHDG);
    setBtn('btnVS', sim.btnVS);
    setBtn('btnHOLD', sim.btnHOLD);
    setBtn('btnAPP', sim.btnAPP);
    setBtn('btnAP', sim.apEngaged);
  }

  // ==================== FMS CDU LOGIC ====================
  function renderCDU() {
    const badge = document.getElementById('cduBadge');
    const title = document.getElementById('cduTitle');
    const rowsEl = document.getElementById('cduRows');
    const lamp = document.getElementById('execLamp');

    if (sim.isMod) {
      badge.textContent = 'MOD';
      badge.className = 'badge-mod';
      lamp.classList.add('on');
    } else {
      badge.textContent = 'ACT';
      badge.className = 'badge-act';
      lamp.classList.remove('on');
    }

    document.getElementById('cduSpText').textContent = sim.scratchpad;
    document.getElementById('cduSpMsg').textContent = sim.spMsg;

    const displayLegs = sim.isMod && sim.modLegs ? sim.modLegs : sim.legs;
    rowsEl.innerHTML = '';

    if (sim.cduPage === 'LEGS') {
      title.textContent = 'RTE 1 LEGS';
      for (let i = 0; i < 5; i++) {
        const leg = displayLegs[i];
        const line = document.createElement('div');
        line.className = 'cdu-line';

        if (leg) {
          const dist = Math.round(Math.hypot(leg.x - sim.acX, leg.y - sim.acY));
          const brg = Math.round((Math.atan2(leg.x - sim.acX, leg.y - sim.acY) * 180 / Math.PI + 360) % 360);
          const colorClass = (i === 0 && !sim.isMod) ? 'color:var(--boeing-magenta)' : 'color:var(--boeing-white)';
          const suffix = leg.type === 'AT' ? 'A' : (leg.type === 'AT_OR_BELOW' ? 'B' : '');
          line.innerHTML = `
            <div class="cdu-side">
              <div class="cdu-lbl">${String(brg).padStart(3,'0')}° &nbsp; ${dist}NM</div>
              <div class="cdu-val" style="${colorClass}">${leg.id}</div>
            </div>
            <div class="cdu-side r">
              <div class="cdu-lbl">${i === 0 ? 'CMD SPD/ALT' : ''}</div>
              <div class="cdu-val" style="${colorClass}">${leg.spd}/${leg.alt}${suffix}</div>
            </div>
          `;
        } else {
          line.innerHTML = `<div class="cdu-side"><div class="cdu-val">-----</div></div><div class="cdu-side r"></div>`;
        }
        rowsEl.appendChild(line);
      }
    } else {
      // VNAV Page
      title.textContent = 'ACT VNAV CLB';
      const active = displayLegs[0] || { id: '---', alt: 10000 };
      const lines = [
        { lLbl: 'CRZ ALT', lVal: `FL${sim.fmsCrzAlt/100}`, rLbl: 'AT ' + active.id, rVal: `${active.alt}A` },
        { lLbl: 'ECON SPD', lVal: `${sim.fmsTargetSpd}KT`, rLbl: 'TRANS ALT', rVal: '14000' },
        { lLbl: 'SPD RESTR', lVal: '250/10000', rLbl: 'MAX ANGLE', rVal: '3.2°' },
        { lLbl: '', lVal: '', rLbl: '', rVal: '' },
        { lLbl: '------------', lVal: '<LEGS', rLbl: '------------', rVal: 'PERF>' }
      ];
      lines.forEach(item => {
        const line = document.createElement('div');
        line.className = 'cdu-line';
        line.innerHTML = `
          <div class="cdu-side">
            <div class="cdu-lbl">${item.lLbl}</div>
            <div class="cdu-val">${item.lVal}</div>
          </div>
          <div class="cdu-side r">
            <div class="cdu-lbl">${item.rLbl}</div>
            <div class="cdu-val" style="color:var(--boeing-magenta)">${item.rVal}</div>
          </div>
        `;
        rowsEl.appendChild(line);
      });
    }
  }

  function cduPage(p) {
    sim.cduPage = p;
    renderCDU();
  }

  function cduChar(c) {
    sim.spMsg = '';
    if (sim.scratchpad === 'DELETE') sim.scratchpad = '';
    if (sim.scratchpad.length < 14) sim.scratchpad += c;
    renderCDU();
  }

  function cduSpPreset(txt) {
    sim.spMsg = '';
    sim.scratchpad = txt;
    renderCDU();
  }

  function cduClr() {
    sim.spMsg = '';
    if (sim.scratchpad === 'DELETE') sim.scratchpad = '';
    else sim.scratchpad = sim.scratchpad.slice(0, -1);
    renderCDU();
  }

  function cduLSK(key) {
    sim.spMsg = '';
    const idx = parseInt(key[0], 10) - 1;
    const side = key[1];

    if (sim.cduPage === 'VNAV' && key === '5L') {
      sim.cduPage = 'LEGS';
      renderCDU();
      return;
    }

    const workLegs = sim.isMod && sim.modLegs ? sim.modLegs : cloneLegs(sim.legs);

    if (side === 'L' && workLegs[idx]) {
      if (sim.scratchpad === '') {
        // Copy waypoint to scratchpad
        sim.scratchpad = workLegs[idx].id;
        setCoach(
          `스크래치패드에 ${workLegs[idx].id} 복사됨`,
          `이제 <b>1L</b> 키를 누르면 ${workLegs[idx].id}(으)로 <b>Direct-To</b> 경로(청록색 MOD 파선)가 생성됩니다.`,
          '<span class="tag-bus">Airbus</span> 전용 <b>DIR</b> 버튼을 누르는 대신, <span class="tag-b787">Boeing 787</span>은 LEGS 페이지에서 원하는 픽스를 클릭해 복사한 뒤 <b>1L(맨 위)</b>에 덮어씌웁니다!'
        );
      } else if (sim.scratchpad === 'DELETE') {
        if (workLegs.length > 1) {
          workLegs.splice(idx, 1);
          sim.modLegs = workLegs;
          sim.isMod = true;
          sim.scratchpad = '';
        }
      } else {
        // Direct-To if pressed on 1L
        const foundIdx = workLegs.findIndex(w => w.id === sim.scratchpad);
        if (idx === 0 && foundIdx > 0) {
          workLegs.splice(0, foundIdx);
          sim.modLegs = workLegs;
          sim.isMod = true;
          sim.scratchpad = '';
          setCoach(
            `MOD 상태 활성화 (ND의 흰색/청록색 파선 확인!)`,
            `아직 비행기가 선회하지 않습니다! ND에서 파선 경로를 확인한 후 반드시 초록색 불이 켜진 <b>EXEC</b> 버튼을 눌러야 경로가 활성화됩니다.`,
            '<span class="tag-bus">Airbus</span> 노란색 <b>TMPY F-PLN → INSERT*</b>와 동일한 2단계 확인 절차입니다.'
          );
        }
      }
    } else if (side === 'R' && workLegs[idx]) {
      if (sim.scratchpad.includes('/')) {
        const parts = sim.scratchpad.split('/');
        const spdVal = parseInt(parts[0], 10) || workLegs[idx].spd;
        const altRaw = parts[1].toUpperCase();
        const altVal = parseInt(altRaw.replace(/[AB]/g, ''), 10) || workLegs[idx].alt;
        workLegs[idx].spd = spdVal;
        workLegs[idx].alt = altVal;
        workLegs[idx].type = altRaw.endsWith('B') ? 'AT_OR_BELOW' : 'AT';
        sim.modLegs = workLegs;
        sim.isMod = true;
        sim.scratchpad = '';
        setCoach(
          `${workLegs[idx].id} 속도/고도 구속조건 수정 (MOD)`,
          `<b>EXEC</b> 버튼을 누르면 수정된 VNAV 구속조건이 즉시 PFD 및 VNAV 프로파일에 반영됩니다.`,
          '<span class="tag-b787">Boeing 787</span> LEGS 우측(1R~5R)에 <code>250/10000A</code> 형태로 직접 입력합니다.'
        );
      } else {
        sim.spMsg = 'USE SPD/ALT';
      }
    }
    renderCDU();
  }

  function cduExec() {
    if (!sim.isMod) return;
    if (sim.modLegs) {
      sim.legs = sim.modLegs;
      sim.modLegs = null;
    }
    sim.isMod = false;
    sim.fmsTargetSpd = sim.legs[0] ? sim.legs[0].spd : 250;
    evaluateVnavMode();
    highlightFMA(2);
    renderCDU();
    setCoach(
      'EXEC 완료 — ACT RTE 1 활성화!',
      'ND의 경로가 마젠타(Magenta) 실선으로 바뀌었으며, LNAV/VNAV가 새로운 경로를 즉시 추종합니다.',
      '<span class="tag-b787">Boeing 787</span> 수정 사항은 언제나 <b>MOD → EXEC</b>로 확정됩니다.'
    );
  }

  // ==================== FLIGHT PHYSICS & MODE ENGINE ====================
  function updatePhysics() {
    const activeLeg = sim.legs[0];

    // 1. Target Speed Determination
    const targetSpd = sim.spdWindowOpen ? sim.mcpSpd : (activeLeg ? activeLeg.spd : sim.fmsTargetSpd);
    const spdErr = targetSpd - sim.ias;
    sim.ias += Math.sign(spdErr) * Math.min(Math.abs(spdErr), 0.18);

    // 2. Roll / Lateral Navigation
    let targetHdg = sim.mcpHdg;
    if (sim.btnLNAV && activeLeg) {
      const dx = activeLeg.x - sim.acX;
      const dy = activeLeg.y - sim.acY;
      const dist = Math.hypot(dx, dy);
      targetHdg = (Math.atan2(dx, dy) * 180 / Math.PI + 360) % 360;

      // Sequence waypoint if close
      if (dist < 1.5 && sim.legs.length > 1) {
        sim.legs.shift();
        renderCDU();
      }
    }

    let hdgDiff = ((targetHdg - sim.hdg + 540) % 360) - 180;
    sim.bank = Math.max(-25, Math.min(25, hdgDiff * 1.2));
    sim.hdg = (sim.hdg + sim.bank * 0.015 + 360) % 360;

    // Move aircraft slowly on ND
    const rad = sim.hdg * Math.PI / 180;
    sim.acX += Math.sin(rad) * 0.012;
    sim.acY += Math.cos(rad) * 0.012;

    // 3. Vertical / Pitch Mode Logic
    let targetAlt = sim.mcpAlt;
    if (sim.btnVNAV) {
      targetAlt = getEffectiveVnavTargetAlt();
    }

    const altDiff = targetAlt - sim.alt;

    if (sim.btnHOLD) {
      sim.vs += (0 - sim.vs) * 0.15;
    } else if (sim.btnVS) {
      if (Math.abs(sim.mcpAlt - sim.alt) < 80) {
        sim.btnVS = false;
        sim.btnHOLD = true;
        sim.fmaPitch = 'ALT';
        highlightFMA(3);
        updateMCPDOM();
      } else {
        sim.vs += (sim.mcpVS - sim.vs) * 0.1;
      }
    } else if (sim.btnFLCH || sim.btnVNAV) {
      if (Math.abs(altDiff) < 90) {
        sim.vs += (0 - sim.vs) * 0.2;
        sim.alt += altDiff * 0.08;

        if (sim.btnVNAV) {
          const prevPitch = sim.fmaPitch;
          if (Math.abs(sim.mcpAlt - sim.alt) < 120 && sim.mcpAlt < sim.fmsCrzAlt) {
            sim.fmaPitch = 'VNAV ALT';
            sim.fmaAT = 'SPD';
            if (prevPitch !== 'VNAV ALT') {
              highlightFMA(3);
              setCoach(
                '⚠️ VNAV ALT 포착! (보잉 787 전환 핵심 포인트)',
                `FMS 목표 고도보다 낮은 MCP 고도(<b>${sim.mcpAlt}ft</b>) 또는 구속고도에 걸려 수평 비행으로 전환되었습니다. 계속 상승하려면 <b>MCP 고도를 올린 뒤 ALT 노브를 PUSH</b>하세요!`,
                '<span class="tag-bus">Airbus</span> `ALT CST*` 또는 `ALT*`에 해당하지만, 보잉에서는 <b>VNAV ALT</b>가 떴을 때 고도만 돌려서는 절대 안 올라가고 반드시 <b>ALT INTV(PUSH)</b>를 눌러야 합니다!'
              );
            }
          } else {
            sim.fmaPitch = 'VNAV PTH';
            sim.fmaAT = 'SPD';
          }
        } else if (sim.btnFLCH) {
          sim.btnFLCH = false;
          sim.btnHOLD = true;
          sim.fmaPitch = 'ALT';
          sim.fmaAT = 'SPD';
          highlightFMA(3);
          updateMCPDOM();
        }
      } else {
        const desiredVS = altDiff > 0 ? 1800 : -1800;
        sim.vs += (desiredVS - sim.vs) * 0.08;
      }
    }

    sim.alt += sim.vs / 1800;
    sim.pitch = Math.max(-5, Math.min(15, 2.0 + (sim.vs / 350)));

    if (sim.fmaBoxTimer > 0) sim.fmaBoxTimer--;
  }

  // ==================== PFD CANVAS RENDERER ====================
  const pfdCtx = document.getElementById('pfdCanvas').getContext('2d');

  function drawPFD() {
    const ctx = pfdCtx;
    const W = 440, H = 390;
    ctx.clearRect(0, 0, W, H);

    // 1. Artificial Horizon (Center at 215, 205)
    const cx = 215, cy = 205, radius = 115;
    ctx.save();
    ctx.beginPath();
    ctx.roundRect(cx - radius, cy - radius, radius * 2, radius * 2, 18);
    ctx.clip();

    ctx.translate(cx, cy);
    ctx.rotate(-sim.bank * Math.PI / 180);
    const pitchPx = sim.pitch * 5.5;

    // Sky & Ground
    ctx.fillStyle = '#005fa8';
    ctx.fillRect(-200, -300 + pitchPx, 400, 300);
    ctx.fillStyle = '#6b441e';
    ctx.fillRect(-200, pitchPx, 400, 300);

    // Horizon Line
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(-200, pitchPx);
    ctx.lineTo(200, pitchPx);
    ctx.stroke();

    // Pitch Ladder
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 10px Consolas';
    for (let p = -15; p <= 20; p += 5) {
      if (p === 0) continue;
      const y = pitchPx - p * 5.5;
      const w = (p % 10 === 0) ? 28 : 14;
      ctx.beginPath();
      ctx.moveTo(-w, y);
      ctx.lineTo(w, y);
      ctx.stroke();
      if (p % 10 === 0) {
        ctx.fillText(Math.abs(p), w + 4, y + 3);
        ctx.fillText(Math.abs(p), -w - 16, y + 3);
      }
    }
    ctx.restore();

    // Flight Director (FD) Bars (Magenta)
    ctx.strokeStyle = '#ff4dff';
    ctx.lineWidth = 3;
    const fdPitchY = cy - (sim.pitch - (sim.vs / 350 + 2)) * 4;
    const fdRollX = cx + (sim.bank * 0.8);
    ctx.beginPath();
    ctx.moveTo(cx - 48, fdPitchY);
    ctx.lineTo(cx + 48, fdPitchY);
    ctx.moveTo(fdRollX, cy - 48);
    ctx.lineTo(fdRollX, cy + 48);
    ctx.stroke();

    // Aircraft Reference Symbol (Black/White L-bars + center square)
    ctx.fillStyle = '#000';
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 2;
    ctx.fillRect(cx - 5, cy - 5, 10, 10);
    ctx.strokeRect(cx - 5, cy - 5, 10, 10);
    ctx.beginPath();
    ctx.moveTo(cx - 65, cy); ctx.lineTo(cx - 25, cy); ctx.lineTo(cx - 25, cy + 8);
    ctx.moveTo(cx + 65, cy); ctx.lineTo(cx + 25, cy); ctx.lineTo(cx + 25, cy + 8);
    ctx.stroke();

    // 2. TOP FMA (Boeing 3-Column Layout)
    ctx.fillStyle = '#0c1118';
    ctx.fillRect(40, 6, 350, 48);
    ctx.strokeStyle = '#334155';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(40, 6, 350, 48);
    ctx.beginPath();
    ctx.moveTo(156, 6); ctx.lineTo(156, 54);
    ctx.moveTo(273, 6); ctx.lineTo(273, 54);
    ctx.stroke();

    // Active FMA Text (Green)
    ctx.fillStyle = '#00ff66';
    ctx.font = 'bold 15px Consolas';
    ctx.textAlign = 'center';
    ctx.fillText(sim.fmaAT, 98, 26);
    ctx.fillText(sim.fmaRoll, 214, 26);
    ctx.fillText(sim.fmaPitch, 331, 26);

    // Highlight Box around recently changed FMA mode
    if (sim.fmaBoxTimer > 0 && sim.fmaChangedCol > 0) {
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      const boxX = sim.fmaChangedCol === 1 ? 45 : (sim.fmaChangedCol === 2 ? 161 : 278);
      ctx.strokeRect(boxX, 9, 106, 22);
    }

    // Armed FMA Modes (White small)
    ctx.fillStyle = '#ffffff';
    ctx.font = '11px Consolas';
    ctx.fillText(sim.fmaRollArmed, 214, 46);
    ctx.fillText(sim.fmaPitchArmed, 331, 46);

    // 3. SPEED TAPE (Left)
    const stX = 14, stY = 75, stW = 62, stH = 250;
    ctx.fillStyle = '#111722';
    ctx.fillRect(stX, stY, stW, stH);
    ctx.strokeStyle = '#475569';
    ctx.strokeRect(stX, stY, stW, stH);

    // Target Speed above tape (Magenta if FMS, Cyan/White if MCP)
    const activeLeg = sim.legs[0];
    const dispTargetSpd = sim.spdWindowOpen ? sim.mcpSpd : (activeLeg ? activeLeg.spd : sim.fmsTargetSpd);
    ctx.fillStyle = sim.spdWindowOpen ? '#ffffff' : '#ff4dff';
    ctx.font = 'bold 14px Consolas';
    ctx.textAlign = 'center';
    ctx.fillText(dispTargetSpd + (sim.spdWindowOpen ? ' MCP' : ' FMS'), stX + 31, stY - 8);

    // Speed Ticks
    ctx.save();
    ctx.beginPath();
    ctx.rect(stX, stY, stW, stH);
    ctx.clip();
    ctx.strokeStyle = '#cbd5e1';
    ctx.fillStyle = '#e2e8f0';
    ctx.font = '12px Consolas';
    ctx.textAlign = 'right';
    const baseSpd = Math.floor(sim.ias / 10) * 10;
    for (let s = baseSpd - 40; s <= baseSpd + 40; s += 10) {
      if (s < 100) continue;
      const y = cy - (s - sim.ias) * 2.8;
      ctx.beginPath();
      ctx.moveTo(stX + stW - 8, y);
      ctx.lineTo(stX + stW, y);
      ctx.stroke();
      ctx.fillText(s, stX + stW - 12, y + 4);
    }

    // Magenta Speed Bug
    const bugY = cy - (dispTargetSpd - sim.ias) * 2.8;
    ctx.strokeStyle = '#ff4dff';
    ctx.lineWidth = 2.5;
    ctx.strokeRect(stX + stW - 10, bugY - 5, 10, 10);
    ctx.restore();

    // Current IAS Readout Box
    ctx.fillStyle = '#000';
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 2;
    ctx.fillRect(stX + 4, cy - 13, stW - 8, 26);
    ctx.strokeRect(stX + 4, cy - 13, stW - 8, 26);
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 16px Consolas';
    ctx.textAlign = 'center';
    ctx.fillText(Math.round(sim.ias), stX + 31, cy + 5);

    // 4. ALTITUDE TAPE (Right)
    const atX = 344, atY = 75, atW = 74, atH = 250;
    ctx.fillStyle = '#111722';
    ctx.fillRect(atX, atY, atW, atH);
    ctx.strokeStyle = '#475569';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(atX, atY, atW, atH);

    // Selected MCP Altitude above tape
    ctx.fillStyle = '#ff4dff';
    ctx.font = 'bold 15px Consolas';
    ctx.textAlign = 'center';
    ctx.fillText(sim.mcpAlt, atX + 37, atY - 8);

    // Altitude Ticks
    ctx.save();
    ctx.beginPath();
    ctx.rect(atX, atY, atW, atH);
    ctx.clip();
    ctx.strokeStyle = '#cbd5e1';
    ctx.fillStyle = '#e2e8f0';
    ctx.font = '12px Consolas';
    ctx.textAlign = 'left';
    const baseAlt = Math.floor(sim.alt / 200) * 200;
    for (let a = baseAlt - 800; a <= baseAlt + 800; a += 200) {
      const y = cy - (a - sim.alt) * 0.14;
      ctx.beginPath();
      ctx.moveTo(atX, y);
      ctx.lineTo(atX + 8, y);
      ctx.stroke();
      ctx.fillText(a, atX + 12, y + 4);
    }
    ctx.restore();

    // Current Altitude Readout Box
    ctx.fillStyle = '#000';
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 2;
    ctx.fillRect(atX + 4, cy - 13, atW - 8, 26);
    ctx.strokeRect(atX + 4, cy - 13, atW - 8, 26);
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 15px Consolas';
    ctx.textAlign = 'center';
    ctx.fillText(Math.round(sim.alt / 10) * 10, atX + 37, cy + 5);

    // V/S Readout at bottom right
    ctx.fillStyle = '#00ff66';
    ctx.font = 'bold 13px Consolas';
    ctx.fillText(`VS ${sim.vs >= 0 ? '+' : ''}${Math.round(sim.vs/50)*50}`, atX + 37, atY + atH + 18);

    // Heading Readout at Bottom Center
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 14px Consolas';
    ctx.fillText(`HDG ${String(Math.round(sim.hdg)).padStart(3,'0')}° (SEL ${String(sim.mcpHdg).padStart(3,'0')}°)`, cx, 365);
  }

  // ==================== ND CANVAS RENDERER ====================
  const ndCtx = document.getElementById('ndCanvas').getContext('2d');

  function drawND() {
    const ctx = ndCtx;
    const W = 440, H = 390;
    ctx.clearRect(0, 0, W, H);

    const acScreenX = W / 2;
    const acScreenY = H - 55;
    const scale = 4.2; // pixels per NM

    // Top ND Info Bar
    ctx.fillStyle = '#00ff66';
    ctx.font = 'bold 13px Consolas';
    ctx.textAlign = 'left';
    ctx.fillText(`GS ${Math.round(sim.ias + 25)}   TAS ${Math.round(sim.ias + 18)}`, 14, 22);

    const activeWpt = sim.legs[0];
    if (activeWpt) {
      const dist = Math.hypot(activeWpt.x - sim.acX, activeWpt.y - sim.acY).toFixed(1);
      ctx.fillStyle = '#ff4dff';
      ctx.textAlign = 'right';
      ctx.fillText(`${activeWpt.id}  ${dist} NM`, W - 14, 22);
    }

    // Compass Rose Arcs
    ctx.strokeStyle = '#263244';
    ctx.lineWidth = 1.2;
    [90, 180, 270].forEach(r => {
      ctx.beginPath();
      ctx.arc(acScreenX, acScreenY, r, Math.PI * 1.15, Math.PI * 1.85);
      ctx.stroke();
    });

    // Helper: Convert world (x, y) to Heading-Up ND Screen Coords
    function toScreen(wx, wy) {
      const dx = wx - sim.acX;
      const dy = wy - sim.acY;
      const rot = (sim.hdg * Math.PI) / 180;
      // Rotate world relative to aircraft heading
      const rx = dx * Math.cos(rot) - dy * Math.sin(rot);
      const ry = dx * Math.sin(rot) + dy * Math.cos(rot);
      return {
        x: acScreenX + rx * scale,
        y: acScreenY - ry * scale
      };
    }

    // 1. Draw Active Route (Magenta Solid Line)
    ctx.strokeStyle = '#ff4dff';
    ctx.lineWidth = 3;
    ctx.setLineDash([]);
    ctx.beginPath();
    ctx.moveTo(acScreenX, acScreenY);
    sim.legs.forEach(w => {
      const pt = toScreen(w.x, w.y);
      ctx.lineTo(pt.x, pt.y);
    });
    ctx.stroke();

    // 2. Draw Modified Route if in MOD state (Cyan/White Dashed Line)
    if (sim.isMod && sim.modLegs) {
      ctx.strokeStyle = '#00e5ff';
      ctx.lineWidth = 2.5;
      ctx.setLineDash([7, 6]);
      ctx.beginPath();
      ctx.moveTo(acScreenX, acScreenY);
      sim.modLegs.forEach(w => {
        const pt = toScreen(w.x, w.y);
        ctx.lineTo(pt.x, pt.y);
      });
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // 3. Draw Waypoint Stars & Altitude Constraints
    const legList = (sim.isMod && sim.modLegs) ? sim.modLegs : sim.legs;
    legList.forEach((w, idx) => {
      const pt = toScreen(w.x, w.y);
      ctx.fillStyle = idx === 0 ? '#ff4dff' : '#ffffff';
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, 4, 0, Math.PI * 2);
      ctx.fill();

      ctx.font = 'bold 12px Consolas';
      ctx.textAlign = 'left';
      ctx.fillText(w.id, pt.x + 8, pt.y + 3);

      if (w.type !== 'NONE') {
        ctx.fillStyle = '#00e5ff';
        ctx.font = '11px Consolas';
        const tag = w.type === 'AT' ? `${w.alt}A` : `${w.alt}B`;
        ctx.fillText(tag, pt.x + 8, pt.y + 16);
      }
    });

    // 4. Selected Heading Bug Dashed Line (if HDG SEL or always visible reference)
    const hdgDiffRad = ((sim.mcpHdg - sim.hdg) * Math.PI) / 180;
    ctx.strokeStyle = '#ff4dff';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(acScreenX, acScreenY);
    ctx.lineTo(acScreenX + Math.sin(hdgDiffRad) * 260, acScreenY - Math.cos(hdgDiffRad) * 260);
    ctx.stroke();
    ctx.setLineDash([]);

    // 5. Own Aircraft Triangle at Bottom
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(acScreenX, acScreenY - 12);
    ctx.lineTo(acScreenX - 10, acScreenY + 10);
    ctx.lineTo(acScreenX + 10, acScreenY + 10);
    ctx.closePath();
    ctx.stroke();
  }

  // ==================== SCENARIO PRESETS ====================
  function loadScenario(type) {
    if (type === 'VNAV_ALT') {
      sim.alt = 9950;
      sim.mcpAlt = 10000;
      sim.vs = 100;
      sim.btnVNAV = true;
      sim.btnLNAV = true;
      sim.btnFLCH = false;
      sim.spdWindowOpen = false;
      sim.fmaPitch = 'VNAV ALT';
      sim.fmaAT = 'SPD';
      highlightFMA(3);
      setCoach(
        '시나리오 1: VNAV ALT에 걸린 상태! (실습해 보세요)',
        '현재 10,000ft에 도달하여 FMA 우측에 <b>VNAV ALT</b>가 떴습니다. <b>[실습]</b> MCP ALT `+` 버튼을 눌러 고도를 <b>15000</b>으로 올린 뒤, <b>PUSH (ALT INTV)</b> 버튼을 눌러 상승을 재개해 보세요!',
        '<span class="tag-b787">Boeing 787 필수 지식</span> 에어버스와 달리 VNAV ALT 상태에서는 MCP 고도만 올리면 비행기가 절대 상승하지 않습니다. 반드시 고도 노브를 <b>PUSH</b> 해야 합니다!'
      );
    } else if (type === 'SPD_INTV') {
      sim.alt = 7500;
      sim.mcpAlt = 16000;
      sim.btnVNAV = true;
      sim.spdWindowOpen = false;
      pushSpdIntv();
    } else if (type === 'DIR_TO') {
      sim.cduPage = 'LEGS';
      sim.scratchpad = 'LANAT';
      cduLSK('1L');
    } else if (type === 'FLCH_VS_VNAV') {
      sim.alt = 7200;
      sim.mcpAlt = 15000;
      pressFLCH();
    }
    updateMCPDOM();
    renderCDU();
  }

  // Download Standalone HTML
  function downloadSelf() {
    const htmlContent = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
    const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'B787_Airbus_Transition_Trainer.html';
    a.click();
  }

  // Main Animation Loop
  function loop() {
    updatePhysics();
    drawPFD();
    drawND();
    requestAnimationFrame(loop);
  }

  // Initialize
  updateMCPDOM();
  renderCDU();
  requestAnimationFrame(loop);
</script>
